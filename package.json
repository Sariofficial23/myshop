{
  "name": "myshop",
  "version": "0.1.0",
  "private": true,
  "description": "MyShop \u2014 \u0443\u0447\u0451\u0442 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u0438\u043a\u0438 \u0432 Telegram Mini App",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@myshop/api --filter=@myshop/web",
    "dev:bot": "turbo run dev --filter=@myshop/bot",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @myshop/database db:generate",
    "db:migrate": "pnpm --filter @myshop/database db:migrate",
    "db:deploy": "pnpm --filter @myshop/database db:deploy",
    "db:seed": "pnpm --filter @myshop/database db:seed",
    "demo:data": "pnpm --filter @myshop/api demo:data",
    "db:status": "pnpm --filter @myshop/database db:status",
    "db:studio": "pnpm --filter @myshop/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.3"
  }
}
