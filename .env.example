# ═══════════════════════════════════════════════════════════════════
#  MyShop — переменные окружения
#  Локально: cp .env.example .env  (корневой .env читают api, bot, database, web)
#  Production: задаются в панелях Render / Vercel. Файл .env НЕ коммитится.
# ═══════════════════════════════════════════════════════════════════

# ── Общие ─────────────────────────────────────────────────────────
NODE_ENV=development

# ── База данных (packages/database, apps/api) ─────────────────────
# Локально — PostgreSQL из docker compose (docker compose up -d db).
# Supabase: DATABASE_URL — Session pooler (порт 5432), DIRECT_URL — тот же
# session pooler или прямое подключение. Подробно: docs/DEPLOYMENT.md
DATABASE_URL=postgresql://myshop:myshop@localhost:5432/myshop?schema=public
DIRECT_URL=postgresql://myshop:myshop@localhost:5432/myshop?schema=public
# Размер пула соединений API (Supabase free: 5–10)
DATABASE_POOL_MAX=10

# ── Backend API (apps/api) ────────────────────────────────────────
PORT=3000
# Разрешённые origin фронтенда через запятую, без "/" в конце
CORS_ORIGINS=http://localhost:3001
# Swagger UI (/api/docs). По умолчанию выключен в production.
# SWAGGER_ENABLED=true
# true — если API работает за прокси (Render). Нужен для корректного rate limit.
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── Авторизация (apps/api) ────────────────────────────────────────
# Секрет подписи JWT, минимум 32 символа. В production — сгенерируйте новый
# (Render: кнопка "Generate"), никогда не используйте это значение!
JWT_ACCESS_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Максимальный возраст Telegram initData в секундах
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
# Вход по демо-пользователям без Telegram. ТОЛЬКО локально, в production запрещено.
AUTH_DEV_LOGIN_ENABLED=true

# ── Telegram (apps/api + apps/bot) ────────────────────────────────
# Токен от @BotFather. СЕКРЕТ — только на сервере.
# API использует его для проверки подписи initData (вход в Mini App).
TELEGRAM_BOT_TOKEN=
# Администраторы платформы (владелец MyShop): Telegram ID через запятую.
# Видят все компании в «Админ-панели», активируют и продлевают подписку.
PLATFORM_ADMIN_TELEGRAM_IDS=
# HTTPS-адрес Mini App (фронтенд на Vercel). Telegram требует https.
MINI_APP_URL=https://localhost:3001

# ── Frontend (apps/web) ───────────────────────────────────────────
# ВНИМАНИЕ: всё с префиксом NEXT_PUBLIC_ попадает в браузер. Никаких секретов!
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ru
# Показать экран входа по демо-пользователям (только вместе с AUTH_DEV_LOGIN_ENABLED)
NEXT_PUBLIC_DEV_LOGIN=true
