// MyShop — схема базы данных (PostgreSQL).
//
// Правила:
//  - у всех важных сущностей есть createdAt / updatedAt;
//  - все данные бизнеса изолированы по companyId (multi-tenant);
//  - остатки товара меняются только через документированные операции
//    (PURCHASE, SALE, RETURN, TRANSFER, WRITE_OFF, INVENTORY_ADJUSTMENT).
//
// ЭТАП 1: Company, Branch.
// ЭТАП 2: User, Membership (роль в компании), MembershipBranch (доступ к филиалам), Session.
// ЭТАП 3: Category, Brand, Product, ProductVariant, Barcode, SerialNumber (IMEI / серийные номера).
// ЭТАП 4: Supplier, Purchase, PurchaseItem, StockMovement, StockBalance, DocumentCounter, AuditLog.
// ЭТАП 5: Customer (минимально), Sale, SaleItem, Payment; продажа по IMEI.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Компания (арендатор). Корень изоляции данных.
/// Статус компании на платформе (SaaS-подписка).
enum CompanyStatus {
  /// Зарегистрировалась, ждёт активации администратором платформы
  PENDING
  /// Работает (до paidUntil; после — только просмотр)
  ACTIVE
  /// Заблокирована администратором платформы
  BLOCKED
}

model Company {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(200)
  /// Название в нижнем регистре — уникально: по нему сотрудники входят в свою компанию.
  nameKey       String?       @unique @map("name_key") @db.VarChar(200)
  status        CompanyStatus @default(ACTIVE)
  /// Подписка оплачена до этой даты. null — без ограничения срока.
  paidUntil     DateTime?     @map("paid_until") @db.Timestamptz(3)
  /// Код валюты ISO 4217, по умолчанию узбекский сум.
  currency      String        @default("UZS") @db.Char(3)
  timezone      String        @default("Asia/Tashkent") @db.VarChar(64)
  /// Текст внизу печатного чека (благодарность, условия обмена и возврата).
  receiptFooter String?       @map("receipt_footer") @db.VarChar(500)
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches            Branch[]
  memberships         Membership[]
  categories          Category[]
  brands              Brand[]
  products            Product[]
  variants            ProductVariant[]
  barcodes            Barcode[]
  serialNumbers       SerialNumber[]
  suppliers           Supplier[]
  documentCounters    DocumentCounter[]
  purchases           Purchase[]
  stockMovements      StockMovement[]
  stockBalances       StockBalance[]
  auditLogs           AuditLog[]
  customers           Customer[]
  sales               Sale[]
  payments            Payment[]
  returns             SaleReturn[]
  refunds             Refund[]
  transfers           Transfer[]
  writeOffs           WriteOff[]
  inventories         Inventory[]
  installments        Installment[]
  installmentPayments InstallmentPayment[]
  cashOperations      CashOperation[]
  warrantyClaims      WarrantyClaim[]

  @@index([createdAt])
  @@map("companies")
}

/// Филиал / торговая точка / склад компании.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(200)
  address   String?  @db.VarChar(500)
  phone     String?  @db.VarChar(32)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  membershipBranches  MembershipBranch[]
  serialNumbers       SerialNumber[]
  purchases           Purchase[]
  stockMovements      StockMovement[]
  stockBalances       StockBalance[]
  sales               Sale[]
  returns             SaleReturn[]
  transfersOut        Transfer[]           @relation("TransferFrom")
  transfersIn         Transfer[]           @relation("TransferTo")
  writeOffs           WriteOff[]
  inventories         Inventory[]
  installments        Installment[]
  installmentPayments InstallmentPayment[]
  cashOperations      CashOperation[]
  warrantyClaims      WarrantyClaim[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("branches")
}

/// Роль сотрудника внутри компании.
enum Role {
  OWNER
  MANAGER
  SELLER
  WAREHOUSE
}

/// Человек. Один пользователь может работать в нескольких компаниях (через Membership).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Telegram user id. Вход в систему — только через проверенный Telegram initData.
  telegramId   BigInt?  @unique @map("telegram_id")
  /// Логин владельца бизнеса (вход по email и паролю).
  email        String?  @unique @db.VarChar(254)
  /// scrypt-хэш пароля владельца. Сам пароль не хранится.
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String?  @map("last_name") @db.VarChar(100)
  username     String?  @db.VarChar(64)
  phone        String?  @db.VarChar(32)
  languageCode String?  @map("language_code") @db.VarChar(8)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships                 Membership[]
  sessions                    Session[]
  purchasesCreated            Purchase[]           @relation("PurchaseCreatedBy")
  purchasesConfirmed          Purchase[]           @relation("PurchaseConfirmedBy")
  stockMovements              StockMovement[]
  auditLogs                   AuditLog[]
  sales                       Sale[]               @relation("SaleSeller")
  paymentsReceived            Payment[]
  returnsCreated              SaleReturn[]         @relation("ReturnCreatedBy")
  refundsPaid                 Refund[]             @relation("RefundPaidBy")
  transfersCreated            Transfer[]           @relation("TransferCreatedBy")
  writeOffsCreated            WriteOff[]           @relation("WriteOffCreatedBy")
  inventoriesCreated          Inventory[]          @relation("InventoryCreatedBy")
  inventoriesConfirmed        Inventory[]          @relation("InventoryConfirmedBy")
  installmentPaymentsReceived InstallmentPayment[] @relation("InstallmentPaymentReceivedBy")
  cashOperationsCreated       CashOperation[]      @relation("CashOperationCreatedBy")
  warrantyClaimsCreated       WarrantyClaim[]      @relation("WarrantyClaimCreatedBy")

  @@index([phone])
  @@map("users")
}

/// Сотрудник компании: пользователь + роль + права + доступ к филиалам.
model Membership {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  role             Role
  /// Дополнительные права сверх роли (например, возвраты для продавца).
  extraPermissions String[]  @default([]) @map("extra_permissions")
  /// true — доступ ко всем филиалам компании, false — только к перечисленным в MembershipBranch.
  allBranches      Boolean   @default(false) @map("all_branches")
  isActive         Boolean   @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)
  /// Логин сотрудника в компании (вход: название компании + логин + пароль).
  login            String?   @db.VarChar(64)
  /// scrypt-хэш пароля сотрудника.
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  branches MembershipBranch[]
  sessions Session[]

  @@unique([companyId, login])
  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId, role])
  @@map("memberships")
}

/// Доступ сотрудника к конкретному филиалу.
model MembershipBranch {
  membershipId String   @map("membership_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
  @@map("membership_branches")
}

/// Сессия входа. Хранит только хэш refresh token; токены ротируются при каждом обновлении.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  membershipId     String    @map("membership_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Сессия, созданная при ротации этой. Повторное использование старого токена = компрометация.
  replacedById     String?   @map("replaced_by_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ip               String?   @db.VarChar(64)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([membershipId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────── Каталог (этап 3) ───────────────────────────

enum ProductUnit {
  PCS
  SET
  PAIR
  M
  KG
}

/// Тип уникального идентификатора единицы товара.
enum SerialType {
  IMEI
  SERIAL
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  TRANSFERRED
  WRITTEN_OFF
}

/// Категория товаров (может быть вложенной: Техника → Телевизоры).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([companyId, name])
  @@map("brands")
}

/// Товар (модель): "iPhone 15". Продаётся и учитывается на складе через варианты.
model Product {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  categoryId     String?     @map("category_id") @db.Uuid
  brandId        String?     @map("brand_id") @db.Uuid
  name           String      @db.VarChar(200)
  sku            String      @db.VarChar(64)
  description    String?     @db.Text
  unit           ProductUnit @default(PCS)
  /// Порог "заканчивается" для отчёта низких остатков.
  minimumStock   Int         @default(0) @map("minimum_stock")
  /// null — обычный товар; IMEI / SERIAL — каждая единица учитывается по номеру.
  serialType     SerialType? @map("serial_type")
  warrantyMonths Int         @default(0) @map("warranty_months")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@unique([companyId, sku])
  @@index([companyId, isActive])
  @@index([companyId, categoryId])
  @@index([companyId, brandId])
  @@index([companyId, name])
  @@map("products")
}

/// Вариант товара: "128GB Black". Остатки, цены, штрихкоды и IMEI привязаны к варианту.
model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  sku        String   @db.VarChar(64)
  /// Отображаемое название варианта, например "128GB Black". null — единственный вариант товара.
  name       String?  @db.VarChar(200)
  model      String?  @db.VarChar(100)
  color      String?  @db.VarChar(60)
  memory     String?  @db.VarChar(30)
  storage    String?  @db.VarChar(30)
  /// Прочие характеристики: { "diagonal": "55\"", "screen": "OLED" }.
  attributes Json     @default("{}")
  /// Текущая цена продажи. Обновляется документом прихода (этап 4).
  salePrice  Decimal? @map("sale_price") @db.Decimal(14, 2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  barcodes       Barcode[]
  serialNumbers  SerialNumber[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  stockBalances  StockBalance[]
  saleItems      SaleItem[]
  returnItems    ReturnItem[]
  transferItems  TransferItem[]
  writeOffItems  WriteOffItem[]
  inventoryItems InventoryItem[]

  @@unique([companyId, sku])
  @@index([productId])
  @@map("product_variants")
}

/// Штрихкод варианта. Один код — один вариант в пределах компании.
model Barcode {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  code      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([variantId])
  @@map("barcodes")
}

/// Конкретная единица товара с IMEI / серийным номером.
/// Создаётся только проведённым документом прихода — вручную добавить нельзя.
/// При продаже получает статус SOLD, ссылку на продажу и срок гарантии.
model SerialNumber {
  id            String       @id @default(uuid()) @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  variantId     String       @map("variant_id") @db.Uuid
  branchId      String       @map("branch_id") @db.Uuid
  purchaseId    String?      @map("purchase_id") @db.Uuid
  saleId        String?      @map("sale_id") @db.Uuid
  saleItemId    String?      @map("sale_item_id") @db.Uuid
  type          SerialType
  number        String       @db.VarChar(64)
  status        SerialStatus @default(IN_STOCK)
  warrantyStart DateTime?    @map("warranty_start") @db.Timestamptz(3)
  warrantyEnd   DateTime?    @map("warranty_end") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  variant        ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchase       Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  sale           Sale?           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleItem       SaleItem?       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  warrantyClaims WarrantyClaim[]

  /// Нельзя дважды добавить один и тот же IMEI в компании.
  @@unique([companyId, number])
  @@index([variantId, status])
  @@index([branchId, status])
  @@index([purchaseId])
  @@index([saleId])
  @@map("serial_numbers")
}

// ─────────────────────── Приход и склад (этап 4) ───────────────────────

/// Поставщик. Полная карточка и история — этап 7.
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(200)
  phone     String?  @db.VarChar(32)
  contact   String?  @db.VarChar(200)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchases Purchase[]

  @@unique([companyId, name])
  @@map("suppliers")
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Сквозная нумерация документов внутри компании (ПР-1, ПР-2, …).
model DocumentCounter {
  companyId String   @map("company_id") @db.Uuid
  type      String   @db.VarChar(32)
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, type])
  @@map("document_counters")
}

/// Приход товара. Остатки меняются только при проведении (CONFIRMED).
model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  branchId       String         @map("branch_id") @db.Uuid
  supplierId     String?        @map("supplier_id") @db.Uuid
  /// Внутренний номер документа в компании.
  number         Int
  /// Номер накладной поставщика.
  documentNumber String?        @map("document_number") @db.VarChar(64)
  date           DateTime       @default(now()) @db.Timestamptz(3)
  status         DocumentStatus @default(DRAFT)
  total          Decimal        @default(0) @db.Decimal(14, 2)
  notes          String?        @db.Text
  createdById    String         @map("created_by_id") @db.Uuid
  confirmedById  String?        @map("confirmed_by_id") @db.Uuid
  confirmedAt    DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy    User?           @relation("PurchaseConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  serialNumbers  SerialNumber[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@index([companyId, status, date])
  @@index([companyId, branchId, date])
  @@index([supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id            String   @id @default(uuid()) @db.Uuid
  purchaseId    String   @map("purchase_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(14, 2)
  /// Новая цена продажи варианта (применяется при проведении).
  salePrice     Decimal? @map("sale_price") @db.Decimal(14, 2)
  total         Decimal  @db.Decimal(14, 2)
  /// IMEI / серийные номера (для товаров с учётом по номеру). Становятся SerialNumber при проведении.
  serialNumbers String[] @default([]) @map("serial_numbers")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchase Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([variantId])
  @@map("purchase_items")
}

/// Тип движения товара. Остаток меняется ТОЛЬКО через движения с документом-источником.
enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  WRITE_OFF
  INVENTORY_ADJUSTMENT
}

/// Движение товара: +приход / −расход в филиале. Неизменяемая история.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  companyId    String            @map("company_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  variantId    String            @map("variant_id") @db.Uuid
  type         StockMovementType
  /// Со знаком: + поступление, − расход.
  quantity     Int
  /// Остаток в филиале после движения — для истории без пересчёта.
  balanceAfter Int               @map("balance_after")
  /// Себестоимость единицы в этом движении.
  unitCost     Decimal?          @map("unit_cost") @db.Decimal(14, 2)
  purchaseId   String?           @map("purchase_id") @db.Uuid
  saleId       String?           @map("sale_id") @db.Uuid
  returnId     String?           @map("return_id") @db.Uuid
  transferId   String?           @map("transfer_id") @db.Uuid
  writeOffId   String?           @map("write_off_id") @db.Uuid
  inventoryId  String?           @map("inventory_id") @db.Uuid
  createdById  String            @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchase  Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  sale      Sale?          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  return    SaleReturn?    @relation(fields: [returnId], references: [id], onDelete: Restrict)
  transfer  Transfer?      @relation(fields: [transferId], references: [id], onDelete: Restrict)
  writeOff  WriteOff?      @relation(fields: [writeOffId], references: [id], onDelete: Restrict)
  inventory Inventory?     @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([variantId, branchId, createdAt])
  @@index([purchaseId])
  @@index([saleId])
  @@index([returnId])
  @@index([transferId])
  @@index([writeOffId])
  @@index([inventoryId])
  @@map("stock_movements")
}

/// Текущий остаток варианта в филиале. Поддерживается в той же транзакции, что и движения.
model StockBalance {
  companyId String   @map("company_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int      @default(0)
  /// Средневзвешенная себестоимость единицы (для валовой прибыли и стоимости склада).
  avgCost   Decimal  @default(0) @map("avg_cost") @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([branchId, variantId])
  @@index([companyId, variantId])
  @@map("stock_balances")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SALE
  PURCHASE
  RETURN
  TRANSFER
  WRITE_OFF
  INVENTORY_ADJUSTMENT
  PAYMENT
}

/// Журнал критических операций. Просмотр и отчёты — этап 8.
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  entity    String      @db.VarChar(64)
  entityId  String?     @map("entity_id") @db.Uuid
  oldValue  Json?       @map("old_value")
  newValue  Json?       @map("new_value")
  ip        String?     @db.VarChar(64)
  userAgent String?     @map("user_agent") @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@map("audit_logs")
}

// ───────────────────────────── Продажи (этап 5) ─────────────────────────────

/// Клиент. Полная карточка, долги, рассрочки и гарантии — этап 7.
model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  name       String   @db.VarChar(200)
  phone      String?  @db.VarChar(32)
  telegramId BigInt?  @map("telegram_id")
  notes      String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sales          Sale[]
  installments   Installment[]
  warrantyClaims WarrantyClaim[]

  @@unique([companyId, phone])
  @@index([companyId, name])
  @@map("customers")
}

/// Способ оплаты продажи (ТЗ, раздел 9).
enum SalePaymentType {
  CASH
  CARD
  TRANSFER
  MIXED
  INSTALLMENT
}

/// Способ конкретного платежа.
enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
}

/// Продажа (чек). Создаётся сразу проведённой: остаток и IMEI меняются в той же транзакции.
model Sale {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  branchId      String          @map("branch_id") @db.Uuid
  customerId    String?         @map("customer_id") @db.Uuid
  sellerId      String          @map("seller_id") @db.Uuid
  number        Int
  date          DateTime        @default(now()) @db.Timestamptz(3)
  status        SaleStatus      @default(COMPLETED)
  paymentType   SalePaymentType @map("payment_type")
  /// Сумма по ценам до скидок.
  subtotal      Decimal         @db.Decimal(14, 2)
  discountTotal Decimal         @default(0) @map("discount_total") @db.Decimal(14, 2)
  /// К оплате = subtotal − discountTotal.
  total         Decimal         @db.Decimal(14, 2)
  paidTotal     Decimal         @default(0) @map("paid_total") @db.Decimal(14, 2)
  /// Себестоимость проданного (для валовой прибыли).
  costTotal     Decimal         @default(0) @map("cost_total") @db.Decimal(14, 2)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller         User            @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       Payment[]
  serialNumbers  SerialNumber[]
  stockMovements StockMovement[]
  returns        SaleReturn[]
  installment    Installment?
  warrantyClaims WarrantyClaim[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([companyId, branchId, date])
  @@index([companyId, sellerId, date])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  quantity         Int
  /// Цена за единицу до скидки.
  price            Decimal  @db.Decimal(14, 2)
  /// Скидка на строку (сумма).
  discount         Decimal  @default(0) @db.Decimal(14, 2)
  /// quantity × price − discount.
  total            Decimal  @db.Decimal(14, 2)
  /// Себестоимость единицы на момент продажи.
  unitCost         Decimal  @map("unit_cost") @db.Decimal(14, 2)
  /// Сколько единиц уже возвращено (не больше quantity — CHECK в БД).
  returnedQuantity Int      @default(0) @map("returned_quantity")
  /// Сколько денег уже возвращено по строке (не больше total).
  refundedAmount   Decimal  @default(0) @map("refunded_amount") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  serialNumbers SerialNumber[]
  returnItems   ReturnItem[]

  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  saleId       String        @map("sale_id") @db.Uuid
  method       PaymentMethod
  amount       Decimal       @db.Decimal(14, 2)
  receivedById String        @map("received_by_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  receivedBy User    @relation(fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([saleId])
  @@map("payments")
}

// ─────────────── Возвраты, перемещения, списания, инвентаризация (этап 6) ───────────────

/// Возврат по продаже. Создаётся сразу проведённым: товар возвращается на склад филиала продажи.
model SaleReturn {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  number        Int
  date          DateTime @default(now()) @db.Timestamptz(3)
  reason        String?  @db.Text
  /// Сумма, возвращённая клиенту.
  refundTotal   Decimal  @map("refund_total") @db.Decimal(14, 2)
  /// Часть суммы возврата, которая уменьшила долг по рассрочке (не выплачивается деньгами).
  debtReduction Decimal  @default(0) @map("debt_reduction") @db.Decimal(14, 2)
  /// Себестоимость возвращённого товара (уменьшает себестоимость продаж в отчётах).
  costTotal     Decimal  @map("cost_total") @db.Decimal(14, 2)
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items          ReturnItem[]
  refunds        Refund[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([saleId])
  @@map("returns")
}

model ReturnItem {
  id            String   @id @default(uuid()) @db.Uuid
  returnId      String   @map("return_id") @db.Uuid
  saleItemId    String   @map("sale_item_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  /// Сумма возврата по строке.
  amount        Decimal  @db.Decimal(14, 2)
  unitCost      Decimal  @map("unit_cost") @db.Decimal(14, 2)
  serialNumbers String[] @default([]) @map("serial_numbers")

  return   SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleItem SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@map("return_items")
}

/// Выплата клиенту при возврате.
model Refund {
  id        String        @id @default(uuid()) @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  returnId  String        @map("return_id") @db.Uuid
  method    PaymentMethod
  amount    Decimal       @db.Decimal(14, 2)
  paidById  String        @map("paid_by_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  return  SaleReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  paidBy  User       @relation("RefundPaidBy", fields: [paidById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([returnId])
  @@map("refunds")
}

/// Перемещение между филиалами. Проводится сразу: TRANSFER_OUT из одного, TRANSFER_IN в другой.
model Transfer {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  fromBranchId String   @map("from_branch_id") @db.Uuid
  toBranchId   String   @map("to_branch_id") @db.Uuid
  number       Int
  date         DateTime @default(now()) @db.Timestamptz(3)
  notes        String?  @db.Text
  createdById  String   @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromBranch     Branch          @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch       Branch          @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items          TransferItem[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("transfers")
}

model TransferItem {
  id            String   @id @default(uuid()) @db.Uuid
  transferId    String   @map("transfer_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  /// Себестоимость единицы на момент перемещения.
  unitCost      Decimal  @map("unit_cost") @db.Decimal(14, 2)
  serialNumbers String[] @default([]) @map("serial_numbers")

  transfer Transfer       @relation(fields: [transferId], references: [id], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("transfer_items")
}

/// Причина списания.
enum WriteOffReason {
  DEFECT
  DAMAGE
  LOSS
  OTHER
}

/// Списание (брак, порча, утеря). Проводится сразу.
model WriteOff {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  branchId    String         @map("branch_id") @db.Uuid
  number      Int
  date        DateTime       @default(now()) @db.Timestamptz(3)
  reason      WriteOffReason
  notes       String?        @db.Text
  costTotal   Decimal        @map("cost_total") @db.Decimal(14, 2)
  createdById String         @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("WriteOffCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items          WriteOffItem[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("write_offs")
}

model WriteOffItem {
  id            String   @id @default(uuid()) @db.Uuid
  writeOffId    String   @map("write_off_id") @db.Uuid
  variantId     String   @map("variant_id") @db.Uuid
  quantity      Int
  unitCost      Decimal  @map("unit_cost") @db.Decimal(14, 2)
  serialNumbers String[] @default([]) @map("serial_numbers")

  writeOff WriteOff       @relation(fields: [writeOffId], references: [id], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([writeOffId])
  @@map("write_off_items")
}

/// Инвентаризация: черновик с подсчётом → проведение (корректировка остатков до факта).
model Inventory {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  branchId      String         @map("branch_id") @db.Uuid
  number        Int
  status        DocumentStatus @default(DRAFT)
  notes         String?        @db.Text
  createdById   String         @map("created_by_id") @db.Uuid
  confirmedById String?        @map("confirmed_by_id") @db.Uuid
  confirmedAt   DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy    User?           @relation("InventoryConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  items          InventoryItem[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@index([companyId, createdAt])
  @@index([branchId, status])
  @@map("inventories")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  inventoryId      String   @map("inventory_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  /// Фактическое количество (для товаров с IMEI = число отсканированных номеров).
  countedQuantity  Int      @map("counted_quantity")
  /// Отсканированные IMEI / серийные номера.
  serialNumbers    String[] @default([]) @map("serial_numbers")
  /// Учётный остаток на момент проведения.
  expectedQuantity Int?     @map("expected_quantity")
  /// Номера, которые числились, но не найдены (списываются при проведении).
  missingSerials   String[] @default([]) @map("missing_serials")
  unitCost         Decimal? @map("unit_cost") @db.Decimal(14, 2)

  inventory Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([inventoryId, variantId])
  @@map("inventory_items")
}

// ─────────────── Рассрочки, касса, гарантии (этап 7) ───────────────

enum InstallmentStatus {
  ACTIVE
  PAID
}

/// Рассрочка по продаже: долг клиента = total − paidAmount − reducedAmount.
model Installment {
  id            String            @id @default(uuid()) @db.Uuid
  companyId     String            @map("company_id") @db.Uuid
  branchId      String            @map("branch_id") @db.Uuid
  saleId        String            @unique @map("sale_id") @db.Uuid
  customerId    String            @map("customer_id") @db.Uuid
  /// Сумма в рассрочку (к оплате минус первоначальный взнос).
  total         Decimal           @db.Decimal(14, 2)
  paidAmount    Decimal           @default(0) @map("paid_amount") @db.Decimal(14, 2)
  /// На сколько уменьшен долг возвратами товара.
  reducedAmount Decimal           @default(0) @map("reduced_amount") @db.Decimal(14, 2)
  months        Int
  /// Ежемесячный платёж (последний месяц забирает остаток от округления).
  monthlyAmount Decimal           @map("monthly_amount") @db.Decimal(14, 2)
  firstDueDate  DateTime          @map("first_due_date") @db.Date
  status        InstallmentStatus @default(ACTIVE)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale     Sale                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments InstallmentPayment[]

  @@index([companyId, status])
  @@index([customerId])
  @@map("installments")
}

/// Платёж клиента по рассрочке.
model InstallmentPayment {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  installmentId String        @map("installment_id") @db.Uuid
  /// Филиал, где приняты деньги (для кассы).
  branchId      String        @map("branch_id") @db.Uuid
  method        PaymentMethod
  amount        Decimal       @db.Decimal(14, 2)
  receivedById  String        @map("received_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  receivedBy  User        @relation("InstallmentPaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([installmentId])
  @@index([branchId, createdAt])
  @@map("installment_payments")
}

/// Операция по кассе филиала, не связанная с продажей.
enum CashOperationType {
  /// Внесение денег в кассу (размен).
  DEPOSIT
  /// Изъятие (инкассация, владелец забрал выручку).
  WITHDRAWAL
  /// Расход из кассы (аренда, доставка, хозяйственные нужды).
  EXPENSE
}

model CashOperation {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @map("company_id") @db.Uuid
  branchId    String            @map("branch_id") @db.Uuid
  type        CashOperationType
  amount      Decimal           @db.Decimal(14, 2)
  reason      String            @db.VarChar(500)
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy User    @relation("CashOperationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([branchId, createdAt])
  @@map("cash_operations")
}

enum WarrantyClaimStatus {
  /// Принят от клиента
  RECEIVED
  /// В ремонте / у поставщика
  IN_REPAIR
  /// Готов к выдаче
  READY
  /// Выдан клиенту
  RETURNED
  /// Отказано в гарантии
  REJECTED
}

/// Гарантийное обращение по проданному IMEI / серийному номеру.
model WarrantyClaim {
  id             String              @id @default(uuid()) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  number         Int
  serialNumberId String              @map("serial_number_id") @db.Uuid
  saleId         String?             @map("sale_id") @db.Uuid
  customerId     String?             @map("customer_id") @db.Uuid
  /// Обращение в пределах гарантийного срока (иначе — платный ремонт).
  inWarranty     Boolean             @map("in_warranty")
  problem        String              @db.Text
  status         WarrantyClaimStatus @default(RECEIVED)
  resolution     String?             @db.Text
  createdById    String              @map("created_by_id") @db.Uuid
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  serialNumber SerialNumber @relation(fields: [serialNumberId], references: [id], onDelete: Restrict)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("WarrantyClaimCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([serialNumberId])
  @@map("warranty_claims")
}
