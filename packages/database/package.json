{
  "name": "@myshop/database",
  "version": "0.1.0",
  "private": true,
  "description": "MyShop: Prisma schema, migrations, seed \u0438 \u0442\u0438\u043f\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 Prisma Client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint": "oxlint --deny-warnings src prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "oxlint": "^1.58.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
